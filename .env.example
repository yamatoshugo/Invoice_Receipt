# --- データベース (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- 認証 (Auth.js v5 + Google) ---
# openssl rand -base64 32 などで生成する
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# このシステムを使えるGoogleアカウントをカンマ区切りで列挙する。
# ここに無いアカウントはログインできない。
ALLOWED_EMAILS="you@example.com"

# --- ファイル保管 (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- 請求書の読み取り (Anthropic) ---
ANTHROPIC_API_KEY=""
