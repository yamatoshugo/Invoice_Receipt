# --- データベース (Neon Postgres) ---
#
# 実行時に使う接続。Neonでは「Pooled connection」（ホスト名に -pooler が入るほう）。
# サーバーレスは関数ごとに接続を張るので、直結だと接続数を使い切る。
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
#
# マイグレーション専用の接続。Neonの「Direct connection」（-pooler が入らないほう）。
# プール(PgBouncer)経由ではDDLが通らないことがあるため分けている。
# ローカルのDockerにはプールが無いので、DATABASE_URL と同じ値でよい。
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# --- 認証 (Auth.js v5 + メールアドレス/パスワード) ---
#
# セッションCookieの署名鍵。openssl rand -base64 32 などで生成する。
# ★この値を変えると全員がログアウトされる（それ以外の影響は無い）。
AUTH_SECRET=""

# 最初の1人を作るための設定。
#
# デプロイ直後は利用者が0人で誰もログインできず、利用者を追加する画面は
# ログインの先にあるため、そのままでは永久に入れない。それを解くためだけの設定。
# ★利用者が1人でも登録されていれば、この2つは無視される（恒久的な裏口にはならない）。
# ★最初のログインが済んだら削除すること。2人目以降は画面［設定 ≫ 利用者］から追加する。
INITIAL_ADMIN_EMAIL="you@example.com"
INITIAL_ADMIN_PASSWORD=""

# --- ファイル保管 (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- 請求書の読み取り (Anthropic) ---
ANTHROPIC_API_KEY=""

# --- Gmail取込 ---
#
# 請求書受け取り専用Gmailを読むためのOAuthクライアント。
# ログインとは無関係（このアプリのログインはGoogleを使わない）。
# gmail.readonly は Google の制限付きスコープで、Workspace組織の
# 「内部(Internal)」アプリなら審査不要。
# 設定手順は README.md の「Gmail取込の設定」を参照。
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""

# リフレッシュトークンの暗号化鍵。openssl rand -base64 32 で生成する（32バイト）。
# AUTH_SECRET とは意図的に別にしている。AUTH_SECRET のローテーションは
# 「全員ログアウトするだけ」の安全な操作なので、そこにGmail連携が壊れる副作用を隠さない。
GMAIL_TOKEN_KEY=""

# このアプリの正規URL。OAuthのリダイレクトURIをここから組み立てるので、
# 認可時とトークン交換時で値が必ず一致する（redirect_uri_mismatch を防ぐ）。
# Google Cloud Console に登録するのは ${APP_BASE_URL}/api/gmail/callback
APP_BASE_URL="http://localhost:3000"

# --- ここから下はローカル動作確認専用。本番(Vercel)には設定しないこと ---
#
# デプロイ前に手元で操作を確認するための設定。
# Vercel Blob / Anthropic の登録なしで一通り触れるようにする。
# 手順は README.md の「ローカルで動かす」を参照。

# PDFの保管先を Vercel Blob ではなくローカルの .uploads/ にする。
# STORAGE="local"

# PDFを読まずにダミーの読み取り結果を返す。
# 本番環境で指定すると起動時にエラーになる（偽の口座情報が振込CSVに載るのを防ぐため）。
# EXTRACTOR="stub"
